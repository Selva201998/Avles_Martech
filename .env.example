# Copy to .env for LOCAL use only. .env is git-ignored.
#
# Server-side only (read by `npm run server`, never bundled into the browser):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# Browser-side (VITE_ variables ARE embedded in the public bundle — never put secrets here):
# Point the app at the local LLM proxy to replace the sample recommender during local experiments.
# Leave empty for the public demo build.
VITE_LLM_PROXY_URL=
